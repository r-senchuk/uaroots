{
  "name": "uaroute",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run src/lib/validate-catalog.test.ts",
    "inspect-out": "node scripts/inspect-out.mjs",
    "check": "npm run docs:check && npm run test:okf && npm run typecheck && npm run lint && npm test && npm run test:seo-release && npm run validate && npm run build && npm run inspect-out && npm run seo:verify-artifact",
    "docs:check": "node scripts/check-docs.mjs && node scripts/okf.mjs --check",
    "poc:report": "node scripts/poc-report.mjs",
    "poc:browser": "node scripts/poc-browser.mjs",
    "poc:live": "node scripts/poc-live.mjs",
    "build:turbopack": "next build --turbopack",
    "seo:generate": "node scripts/seo-http-generate.mjs",
    "seo:http": "node scripts/seo-http.mjs",
    "release:preflight": "bash scripts/deploy.sh --dry-run",
    "test:seo-release": "node --test scripts/seo-release.test.mjs scripts/release-tooling.test.mjs scripts/production-release.test.mjs",
    "seo:verify-artifact": "node scripts/seo-http-generate.mjs --check",
    "docs:index": "node scripts/okf.mjs --write",
    "test:okf": "node --test scripts/okf.test.mjs",
    "attribution:browser": "node scripts/attribution-browser.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.8",
    "js-yaml": "^4.3.2",
    "serve": "14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
